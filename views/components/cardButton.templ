package components

templ CardButton(onclick templ.ComponentScript, text string) {
    @CardButtonStyle()
    <button class="card-button" onclick={onclick}>{text}</button>
}

templ CardButtonStyle() {
    <style>
        .card-button {
            border-radius: 8px;
            color: var(--color-white);
            text-decoration: none;
            padding: 14px 20px;
            border: 0;
            background-color: var(--color-green-primary);
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }
        .card-button:hover {
            background-color: var(--color-green-primary-hover);
        }
    </style>
}