package components

templ Form() {
    <form class={FormClass()} id="new-job-post" action="/publishJobPost" method="post">
        {children...}
    </form>
}

css FormClass() {
    display: {"grid"};
    grid-template-columns: {templ.SafeCSSProperty("minmax(200px, 435px) minmax(200px, 435px)")};
    gap: {"30px 24px"};
    padding: {"0 20px"};
    justify-content: {"center"};
    width: {"100%"};
    align-self: {"stretch"};
}
