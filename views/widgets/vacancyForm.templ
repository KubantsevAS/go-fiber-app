package widgets

import "demo/go-fiber/views/components"

templ VacancyForm() {
    <form class={VacancyFormClass()} id="vacancy-form" action="/vacancy" method="post">
        @components.Input(components.InputProps{
            Name: "job_title",
            Placeholder: "Job Title",
        })
        @components.Input(components.InputProps{
            Name: "company",
            Placeholder: "Company",
        })
        @components.Input(components.InputProps{
            Name: "company_scope",
            Placeholder: "Company scope",
        })
        @components.Input(components.InputProps{
            Name: "salary",
            Placeholder: "Salary",
        })
        @components.Input(components.InputProps{
            Name: "location",
            Placeholder: "Location",
        })
        @components.Input(components.InputProps{
            Name: "email",
            Placeholder: "Email",
        })
        @components.SubmitButton(){
            Publish Vacancy
        }
    </form>
}

css VacancyFormClass() {
    display: {"grid"};
    grid-template-columns: {templ.SafeCSSProperty("minmax(200px, 435px) minmax(200px, 435px)")};
    gap: {"30px 24px"};
    padding: {"0 20px"};
    justify-content: {"center"};
    width: {"100%"};
    align-self: {"stretch"};
}
